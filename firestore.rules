rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function areFriends(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }
    // Friend requests are addressed by email, so the email must be proven (Google
    // accounts always are; email/password accounts after clicking the verification link).
    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function requestExists(id) {
      return exists(/databases/$(database)/documents/friendRequests/$(id));
    }

    // Public profile (name + photo). Readable one at a time by id (friends, request
    // senders), but not listable, so nobody can download the user directory.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'nameLower', 'photoURL', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.nameLower == request.resource.data.displayName.lower()
        // Only Google profile photos, so a photo can't point at a tracking server.
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000
        && (request.resource.data.photoURL == ''
            || request.resource.data.photoURL.matches('https://[a-z0-9-]+[.]googleusercontent[.]com/.*'));
    }

    match /users/{uid} {
      // Seen / rating / review per movie. Visible to the owner and their friends.
      match /movies/{movieId} {
        allow read: if isUser(uid) || areFriends(uid);
        allow delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && movieId.matches('tt[0-9]+')
          && request.resource.data.keys().hasOnly(['seen', 'rating', 'review', 'updatedAt'])
          && request.resource.data.seen is bool
          && request.resource.data.rating is int
          && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
          && request.resource.data.review is string
          && request.resource.data.review.size() <= 500;
      }

      // Default Browse filters and layout. Private to the owner.
      match /settings/{docId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && docId == 'prefs'
          && request.resource.data.keys().hasOnly(['filters', 'layout', 'updatedAt'])
          && request.resource.data.layout in ['cards', 'compact']
          && request.resource.data.filters is map
          && request.resource.data.filters.keys().hasOnly(['category', 'genre', 'from', 'to', 'result', 'status', 'sort']);
      }

      // Friendship is stored on both sides. Only the recipient of a pending request
      // (friendRequests/{senderUid}_{recipientEmail}) can create it, by accepting.
      match /friends/{friendId} {
        allow read: if isUser(uid) || isUser(friendId);
        allow create: if request.resource.data.keys().hasOnly(['since']) && verifiedEmail() && (
          (isUser(uid) && requestExists(friendId + '_' + myEmail())) ||
          (isUser(friendId) && requestExists(uid + '_' + myEmail()))
        );
        allow delete: if isUser(uid) || isUser(friendId);
      }
    }

    // Friend requests are addressed to an email. Sending never reveals whether anyone
    // has that email: the request is simply stored, and only an account with that
    // (verified) email can ever see it. Id: {senderUid}_{recipientEmail}.
    match /friendRequests/{requestId} {
      allow get, list: if signedIn() && (
        resource.data.from == request.auth.uid ||
        (verifiedEmail() && resource.data.toEmail == myEmail())
      );
      allow create: if verifiedEmail()
        && request.resource.data.keys().hasOnly(['from', 'fromEmail', 'toEmail', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.fromEmail == myEmail()
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail.size() <= 254
        && request.resource.data.toEmail == request.resource.data.toEmail.lower()
        && request.resource.data.toEmail.matches('[^@ /]+@[^@ /]+[.][^@ /]+')
        && request.resource.data.toEmail != myEmail()
        && requestId == request.auth.uid + '_' + request.resource.data.toEmail;
      // Sender cancels, or recipient accepts/cancels.
      allow delete: if signedIn() && (
        resource.data.from == request.auth.uid ||
        (verifiedEmail() && resource.data.toEmail == myEmail())
      );
    }
  }
}
